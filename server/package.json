{
  "name": "helpdesk-server",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@google/genai": "^3.2.0",
    "@nestjs/common": "^12.4.2",
    "@nestjs/core": "^12.4.2",
    "@nestjs/jwt": "^12.0.4",
    "@nestjs/platform-express": "^12.4.2",
    "@nestjs/platform-socket.io": "^12.4.2",
    "@nestjs/typeorm": "^12.0.3",
    "@nestjs/websockets": "^12.4.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.11.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "ffmpeg-static": "^5.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "typeorm": "^0.3.31",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.12",
    "@nestjs/testing": "^12.5.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^29.7.0",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "jest": {
    "rootDir": ".",
    "testRegex": "test/.*\\.spec\\.ts$",
    "testEnvironment": "node",
    "extensionsToTreatAsEsm": [
      ".ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "useESM": true,
          "isolatedModules": true,
          "tsconfig": {
            "module": "ESNext",
            "moduleResolution": "node",
            "target": "ES2022",
            "experimentalDecorators": true,
            "emitDecoratorMetadata": true,
            "esModuleInterop": true
          }
        }
      ]
    }
  }
}
